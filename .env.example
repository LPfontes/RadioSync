# Chave secreta para assinatura dos tokens JWT (obrigatória; o valor abaixo é
# recusado na subida). Mínimo de 32 caracteres. Gere uma com:  openssl rand -hex 32
JWT_SECRET=coloque_uma_chave_secreta_longa_e_aleatoria_aqui
# Validade do token de DJ, renovada sempre que o DJ abre a sala (formato Go: 12h, 24h...)
DJ_TOKEN_TTL=24h

# Senha do painel /admin. Vazia = rotas de admin desabilitadas (503).
# Gere uma com:  openssl rand -base64 24
ADMIN_PASSWORD=
# Validade do token de admin emitido no login (formato Go: 30m, 8h...)
ADMIN_TOKEN_TTL=8h

# Porta do host:
# Use 8080 para expor diretamente na internet (ex: http://IP_DA_VPS:8080)
# Ou use 127.0.0.1:8080 se for colocar atrás de Nginx/Caddy com HTTPS
HOST_PORT=8080

# Interface onde o dashboard do Traefik e o /metrics (porta 8081) são
# publicados. Padrão: só a máquina local (no servidor, use túnel SSH).
# A senha do dashboard é gerada com ./scripts/traefik-dashboard-password.sh
TRAEFIK_DASHBOARD_BIND=127.0.0.1

# Porta do API Gateway (Traefik)
GATEWAY_PORT=80

# --- Infraestrutura (valores de desenvolvimento; troque fora do ambiente local)
RABBITMQ_USER=radiosync
RABBITMQ_PASSWORD=radiosync

POSTGRES_USER=radiosync
POSTGRES_PASSWORD=radiosync
POSTGRES_DB=radiosync

MINIO_ROOT_USER=radiosync
MINIO_ROOT_PASSWORD=radiosync123

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --- Segurança de borda (ADR-0005)
# Origens extras aceitas no CORS e no WebSocket, separadas por vírgula.
# Vazio (padrão) = só a mesma origem, o que já cobre o app servido pelo
# backend, pelo gateway e pelo proxy do Vite. Preencha só se o frontend for
# hospedado em outro domínio, ex.: https://radio.exemplo.com
ALLOWED_ORIGINS=
