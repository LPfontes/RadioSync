# Chave secreta para assinatura dos tokens JWT das estações (obrigatório alterar em produção)
# Gere uma com:  openssl rand -hex 32
JWT_SECRET=coloque_uma_chave_secreta_longa_e_aleatoria_aqui

# Porta do host:
# Use 8080 para expor diretamente na internet (ex: http://IP_DA_VPS:8080)
# Ou use 127.0.0.1:8080 se for colocar atrás de Nginx/Caddy com HTTPS
HOST_PORT=8080

# Porta do API Gateway (Traefik)
GATEWAY_PORT=80

# --- Infraestrutura (valores de desenvolvimento; troque fora do ambiente local)
RABBITMQ_USER=radiosync
RABBITMQ_PASSWORD=radiosync

POSTGRES_USER=radiosync
POSTGRES_PASSWORD=radiosync
POSTGRES_DB=radiosync

MINIO_ROOT_USER=radiosync
MINIO_ROOT_PASSWORD=radiosync123

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
